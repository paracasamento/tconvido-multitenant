# REQUIRED — Production / Preview
# Use the restricted app_runtime connection string from Neon tconvido-multitenant.
DATABASE_URL=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=gift-images

NEXT_PUBLIC_SITE_URL=https://tconvido-multitenant.vercel.app
APP_SECURITY_SECRET=
ALLOW_DRAFT_GUEST_ACCESS=false

