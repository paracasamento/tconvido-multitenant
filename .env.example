# Neon — use the restricted app_runtime connection string from the NEW multitenant project
DATABASE_URL=

# Supabase Storage
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback also supported: SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=gift-images

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Generate a long random secret. Used only to HMAC anonymous rate-limit identifiers.
APP_SECURITY_SECRET=

# Keep false in production. Set true locally while testing events still in draft.
ALLOW_DRAFT_GUEST_ACCESS=false

# Optional local/bootstrap scripts only
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
